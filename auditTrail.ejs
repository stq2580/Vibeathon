<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rihaee | Case Intelligence</title>

    <link rel="stylesheet" href="/css/auditTrail.css">
</head>

<body>

    <!-- HEADER -->
    <header>

        <div class="logo">
            Riha<span>ee</span>
        </div>

        <div class="header-right">
            Case Intelligence
        </div>

    </header>


    <!-- MAIN -->
    <main class="container">

        <!-- PAGE HEADING -->
        <div class="page-heading">

            <p class="eyebrow">
                PRELIMINARY CASE ASSESSMENT
            </p>

            <h1>
                Why Was This Case Flagged?
            </h1>

            <p>
                Review the custody, statutory threshold and case history
                information used to flag this case.
            </p>

        </div>


        <!-- PRISONER CARD -->
        <div class="prisoner-card">

            <div>
                <p class="label">
                    PRISONER
                </p>

                <h2>
                    <%= prisoner.undertrial_name %>
                </h2>
            </div>

            <div>
                <p class="label">
                    JAIL
                </p>

                <p class="value">
                    <%= prisoner.jail_name %>
                </p>
            </div>

        </div>


        <!-- CURRENT CASE -->
        <section class="card">

            <div class="section-heading">

                <div>
                    <p class="section-label">
                        CASE DETAILS
                    </p>

                    <h2>
                        Current Case
                    </h2>
                </div>

            </div>


            <div class="information-grid">

                <div class="information">
                    <p class="label">
                        Case Name
                    </p>

                    <p class="value">
                        <%= prisoner.case_details.case_name %>
                    </p>
                </div>


                <div class="information">
                    <p class="label">
                        Case Number
                    </p>

                    <p class="value">
                        <%= prisoner.case_details.case_no %>
                    </p>
                </div>


                <div class="information">
                    <p class="label">
                        Maximum Statutory Punishment
                    </p>

                    <p class="value large-value">
                        <%= prisoner.offense_details.maxCustodyPeriodForOffense %>
                        <span>Years</span>
                    </p>
                </div>


                <div class="information">
                    <p class="label">
                        Custody Start Date
                    </p>

                    <p class="value">
                        <%= new Date(
                            prisoner.case_details.custody_start_date
                        ).toLocaleDateString('en-IN') %>
                    </p>
                </div>

            </div>

        </section>


        <%
            const today = new Date();

            const custodyStart = new Date(
                prisoner.case_details.custody_start_date
            );

            const diffTime = today - custodyStart;

            const continuousDetentionDays = Math.floor(
                diffTime / (1000 * 60 * 60 * 24)
            );

            const maxPunishment =
                prisoner.offense_details.maxCustodyPeriodForOffense;

            const previousCases =
                prisoner.previous_case || [];

            const hasPreviousCases =
                previousCases.length > 0;

            const thresholdFraction =
                hasPreviousCases ? (1 / 2) : (1 / 3);

            const thresholdLabel =
                hasPreviousCases ? "1/2" : "1/3";

            const thresholdYears =
                maxPunishment * thresholdFraction;

            const thresholdDate =
                new Date(custodyStart);

            thresholdDate.setTime(
                thresholdDate.getTime() +
                thresholdYears *
                365.25 *
                24 *
                60 *
                60 *
                1000
            );

            const remainingTime =
                thresholdDate - today;

            const daysRemaining =
                Math.ceil(
                    remainingTime /
                    (1000 * 60 * 60 * 24)
                );
        %>


        <!-- FLAGGING ANALYSIS -->
        <section class="card flag-analysis-card">

            <div class="section-heading">

                <div>

                    <p class="section-label">
                        CASE INTELLIGENCE
                    </p>

                    <h2>
                        Flagging Analysis
                    </h2>

                    <p class="section-description">
                        Key factors used by Rihaee to identify this case
                        for preliminary review.
                    </p>

                </div>

            </div>


            <div class="flag-analysis-grid">


                <!-- FACTOR 1 -->
                <div class="flag-factor">

                    <div class="factor-number">
                        01
                    </div>

                    <div class="factor-content">

                        <p class="factor-label">
                            MAXIMUM PUNISHMENT
                        </p>

                        <h3>
                            <%= maxPunishment %>
                            <span>Years</span>
                        </h3>

                        <p>
                            Maximum statutory punishment recorded
                            for this offence.
                        </p>

                    </div>

                </div>


                <!-- FACTOR 2 -->
                <div class="flag-factor">

                    <div class="factor-number">
                        02
                    </div>

                    <div class="factor-content">

                        <p class="factor-label">
                            APPLICABLE THRESHOLD
                        </p>

                        <h3>
                            <%= thresholdLabel %>
                        </h3>

                        <p>
                            Preliminary threshold:
                            <strong>
                                <%= thresholdYears.toFixed(2) %> years
                            </strong>
                        </p>


                        <% if (hasPreviousCases) { %>

                            <span class="factor-note history-note">
                                Previous history detected
                            </span>

                        <% } else { %>

                            <span class="factor-note">
                                No previous case history
                            </span>

                        <% } %>

                    </div>

                </div>


                <!-- FACTOR 3 -->
                <div class="flag-factor">

                    <div class="factor-number">
                        03
                    </div>

                    <div class="factor-content">

                        <p class="factor-label">
                            CONTINUOUS DETENTION
                        </p>

                        <h3>
                            <%= continuousDetentionDays %>
                            <span>Days</span>
                        </h3>

                        <p>
                            Calculated from the recorded
                            custody start date.
                        </p>

                    </div>

                </div>


                <!-- FACTOR 4 -->
                <div class="flag-factor">

                    <div class="factor-number">
                        04
                    </div>

                    <div class="factor-content">

                        <p class="factor-label">
                            THRESHOLD MATURITY
                        </p>

                        <h3 class="threshold-date">
                            <%= thresholdDate.toLocaleDateString('en-IN') %>
                        </h3>


                        <% if (daysRemaining > 0) { %>

                            <span class="factor-note remaining-note">
                                <%= daysRemaining %> days remaining
                            </span>

                        <% } else { %>

                            <span class="factor-note reached-note">
                                Threshold reached
                            </span>

                        <% } %>

                    </div>

                </div>


            </div>

        </section>


        <!-- PREVIOUS CASE HISTORY -->
        <% if (hasPreviousCases) { %>

            <section class="card previous-history-card">

                <div class="section-heading">

                    <div>

                        <p class="section-label">
                            CASE HISTORY
                        </p>

                        <h2>
                            Previous Case History
                        </h2>

                        <p class="section-description">
                            Previously recorded cases associated
                            with this prisoner.
                        </p>

                    </div>


                    <div class="history-count">

                        <strong>
                            <%= previousCases.length %>
                        </strong>

                        <span>
                            Previous
                            <%= previousCases.length === 1
                                ? "Case"
                                : "Cases" %>
                        </span>

                    </div>

                </div>


                <!-- NOTICE -->
                <div class="history-notice">

                    <div class="notice-icon">
                        i
                    </div>

                    <div>

                        <strong>
                            Previous case history detected
                        </strong>

                        <p>
                            These records are displayed as supporting
                            information for preliminary review.
                        </p>

                    </div>

                </div>


                <!-- PREVIOUS CASES -->
                <div class="previous-cases-list">

                    <% previousCases.forEach((previousCase, index) => { %>

                        <div class="previous-case-card">


                            <!-- CASE NUMBER -->
                            <div class="case-index">

                                <span>
                                    CASE
                                </span>

                                <strong>
                                    <%= String(index + 1).padStart(2, "0") %>
                                </strong>

                            </div>


                            <!-- CASE NAME -->
                            <div class="previous-case-main">

                                <h3>
                                    <%= previousCase.case_name %>
                                </h3>

                                <p class="case-number">
                                    Case No:
                                    <strong>
                                        <%= previousCase.case_no %>
                                    </strong>
                                </p>

                            </div>


                            <!-- DATE -->
                            <div class="previous-case-detail">

                                <span>
                                    DATE
                                </span>

                                <strong>

                                    <%= previousCase.date
                                        ? new Date(previousCase.date)
                                            .toLocaleDateString('en-IN')
                                        : "Not available" %>

                                </strong>

                            </div>


                            <!-- STATUS -->
                            <div class="previous-case-detail">

                                <span>
                                    STATUS
                                </span>

                                <strong>
                                    <%= previousCase.status || "Not available" %>
                                </strong>

                            </div>


                            <!-- OUTCOME -->
                            <div class="previous-case-detail">

                                <span>
                                    OUTCOME
                                </span>

                                <strong>
                                    <%= previousCase.outcome || "Not available" %>
                                </strong>

                            </div>


                        </div>

                    <% }) %>

                </div>

            </section>

        <% } %>


        <!-- FLAGGED MESSAGE -->
        <section class="flagged-card">

            <div class="flag-icon">
                !
            </div>

            <div>

                <h2>
                    Case Flagged for Review
                </h2>

                <p>
                    This case has been flagged for preliminary legal
                    aid counsel verification and custody audit.
                </p>

            </div>

        </section>


        <!-- ACTIONS -->
        <div class="actions">

            <a href="/undertrials/priorityQueue">

                <button type="button" class="back-btn">
                    ← Back to Priority Queue
                </button>

            </a>

            <button type="button" class="report-btn">
                Generate Report
            </button>

        </div>

    </main>

</body>

</html>